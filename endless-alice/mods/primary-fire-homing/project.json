{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "endless-alice-primary-fire-homing",
  "projectType": "library",
  "sourceRoot": "endless-alice/mods/primary-fire-homing/src",
  "tags": ["game:endless-alice", "type:mod"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "inputs": ["default", "{workspaceRoot}/endless-alice/scripts/package-mod.mjs"],
      "outputs": ["{projectRoot}/bin/Release"],
      "options": {
        "cwd": "endless-alice/mods/primary-fire-homing",
        "command": "node package.mjs release"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": "endless-alice/mods/primary-fire-homing",
        "command": "node package.mjs debug"
      }
    }
  }
}
