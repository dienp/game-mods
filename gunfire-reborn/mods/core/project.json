{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "gunfire-reborn-core",
  "projectType": "library",
  "sourceRoot": "gunfire-reborn/mods/core",
  "tags": ["game:gunfire-reborn", "type:mod"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/bin/Release/net6.0"],
      "options": {
        "cwd": "gunfire-reborn/mods/core",
        "command": "dotnet build -c Release --nologo"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "gunfire-reborn/mods/core",
        "command": "dotnet watch --no-hot-reload build -c Debug --nologo"
      }
    }
  }
}
