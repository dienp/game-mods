{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "anomalith-upgrade-tracker",
  "projectType": "library",
  "sourceRoot": "anomalith/mods/upgrade-tracker",
  "tags": ["game:anomalith", "type:mod"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": false,
      "outputs": ["{projectRoot}/bin/Release/netstandard2.1", "{projectRoot}/bin/Release/net6.0"],
      "options": {
        "cwd": "anomalith/mods/upgrade-tracker",
        "command": "dotnet build -c Release --nologo"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "anomalith/mods/upgrade-tracker",
        "command": "dotnet watch --no-hot-reload build -c Debug --nologo /p:DeployAnomalithDebug=true"
      }
    },
    "spec": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node anomalith/scripts/spec.mjs mods/upgrade-tracker validate --all --strict"
      }
    }
  }
}
